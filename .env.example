# 이 파일을 복사해 .env.local 로 만들고 값을 채운다. (.env.local 은 커밋 금지)

# --- Supabase (공개 가능: 클라이언트에서 사용) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (서버 전용: 절대 노출 금지) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (서버 전용: 절대 노출 금지) ---
# OpenAI 호환 API. 기본은 Upstage Solar(교사 무료 크레딧, 한국어 강점).
# OpenAI 를 쓰려면 OPENAI_BASE_URL 을 비우고 키/모델을 OpenAI 것으로 바꾸면 됨.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.upstage.ai/v1
OPENAI_MODEL_DEFAULT=solar-pro4
OPENAI_MODEL_ESCALATION=solar-pro4
# 교사 보조 전용(지문 분석·추천 등, 가끔 호출 → 최상위 모델 써도 총비용 작음).
# 비워 두면 OPENAI_MODEL_ESCALATION 로 폴백. 학생 코치 비용과 분리됨.
# 예) OpenAI 최상위: OPENAI_MODEL_TEACHER=gpt-5.5  (정확한 모델 ID는 OpenAI 가격 페이지에서 확인)
OPENAI_MODEL_TEACHER=

# --- 앱 설정 ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
