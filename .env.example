# 이 파일을 복사해 .env.local 로 만들고 값을 채운다. (.env.local 은 커밋 금지)

# --- Supabase (공개 가능: 클라이언트에서 사용) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (서버 전용: 절대 노출 금지) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (서버 전용: 절대 노출 금지) ---
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4o-mini
# 상위 승급 모델 (미정: 예 gpt-4o). plan.md 12.2 질문2 확정 후 기입
OPENAI_MODEL_ESCALATION=gpt-4o

# --- 앱 설정 ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
