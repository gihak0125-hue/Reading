#!/usr/bin/env sh
# 커밋 전 로컬 검증. husky 설치 후 활성화된다.
# (M0 단계에서는 package.json/스크립트가 없으면 조용히 통과)

if [ -f package.json ]; then
  if npm run | grep -q " typecheck"; then npm run typecheck || exit 1; fi
  if npm run | grep -q " lint"; then npm run lint || exit 1; fi
fi

# 서버 시크릿이 클라이언트 코드에 새어들어갔는지 스캔
if grep -REn "OPENAI_API_KEY|SUPABASE_SERVICE_ROLE_KEY" app components 2>/dev/null | grep -v "process.env"; then
  echo "❌ 클라이언트 코드에 서버 시크릿 참조가 있습니다. 커밋 중단."
  exit 1
fi

exit 0
